# Caddy liefert die statische Oberfläche aus und reicht /api an die API durch.
# Das Zertifikat holt und erneuert Caddy selbst. Für "localhost" nimmt es eine
# eigene lokale Zertifizierungsstelle, damit sich derselbe Aufbau auch auf dem
# eigenen Rechner mit HTTPS prüfen lässt.

{$SITE_ADDRESS} {
	encode zstd gzip

	# Keine Werbung für Server und Version. "defer", damit das auch für
	# Antworten der API gilt, deren Header erst nach dem Durchreichen feststehen.
	header {
		-Server
		-Via
		defer
	}

	# Die API setzt ihre Sicherheitsheader selbst (helmet), Downloads bekommen
	# dort eine eigene, strengere Richtlinie. Caddy überschreibt hier nichts.
	# Die API vertraut genau diesem einen Hop: TRUST_PROXY_HOPS=1.
	handle /api/* {
		reverse_proxy api:4000
	}

	handle {
		root * /srv

		# Nur eigene Quellen. Keine Inline-Skripte, keine fremden Schriften,
		# keine Einbettungen: das ist möglich, weil die Schriften vom eigenen
		# Server kommen und der Build kein Inline-Skript erzeugt. Gegengeprüft
		# mit e2e/production.spec.ts, dort muss die Liste der Verstösse leer sein.
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
			Cross-Origin-Opener-Policy "same-origin"
			X-Frame-Options "DENY"
		}

		# Dateinamen mit Inhalts-Hash ändern sich bei jeder Änderung, sie dürfen
		# also für immer im Cache liegen. Schriften haben keinen Hash, darum nur
		# 30 Tage. Alles andere, vor allem die index.html, fragt jedes Mal nach.
		# Die Matcher schliessen einander aus: Caddy sortiert gleichnamige
		# Direktiven nach Pfad, eine Regel ohne Pfad liefe sonst zuletzt und
		# überschriebe die beiden anderen.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@fonts path /fonts/*
		header @fonts Cache-Control "public, max-age=2592000"
		@other not path /assets/* /fonts/*
		header @other Cache-Control "no-cache"

		# Die Oberfläche routet selbst. Jeder unbekannte Pfad bekommt die
		# index.html, die API-Pfade sind oben schon abgefangen.
		try_files {path} /index.html
		file_server
	}
}

# Evidarium läuft als eigenes Projekt auf demselben Server, mit eigenem
# Compose und eigener Datenbank. Die Ports 80 und 443 besitzt aber dieser
# Caddy, darum bedient er auch dessen Adresse und reicht sie weiter. Erreichbar
# ist Evidarium, weil sein Webdienst zusätzlich in diesem Netz hängt (dort
# `proxy`, extern); umgekehrt ändert sich hier nichts, wenn Evidarium steht.
#
# Ohne gesetzte Adresse gilt ein lokaler Name: In der Entwicklung soll Caddy
# kein Zertifikat für eine fremde Domain holen.
{$EVIDARIUM_SITE_ADDRESS:evidarium.localhost} {
	encode zstd gzip

	# Zweite Schranke vor der Anwendung; Evidarium prüft die Grösse selbst.
	request_body {
		max_size 3MB
	}

	# Der Antwortstrom darf nicht gepuffert werden: Evidariums Schrittanzeige
	# lebt davon, dass jede Zeile sofort ankommt.
	reverse_proxy evidarium-web:3100 {
		flush_interval -1
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
		-Via
		defer
	}

	# Nach Zeit löschen, nicht nur nach Grösse: Evidariums
	# Datenschutzerklärung nennt 14 Tage für Serverprotokolle.
	log {
		output file /var/log/caddy/evidarium.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 336h
		}
	}
}
